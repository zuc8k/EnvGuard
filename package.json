{
  "name": "@boodyzucks/secretscope",
  "version": "0.1.0",
  "description": "Privacy-first CLI that audits .env files against TypeScript/JavaScript code, detects unused or missing environment variables, and flags likely secret leaks with masked output.",
  "keywords": [
    "security",
    "secrets",
    "env",
    "dotenv",
    "environment-variables",
    "audit",
    "sarif",
    "cli",
    "typescript",
    "nodejs"
  ],
  "license": "MIT",
  "author": "Boody Zucks",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "secretscope": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "fast-glob": "^3.3.2",
    "ts-morph": "^23.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "eslint": "^9.10.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}